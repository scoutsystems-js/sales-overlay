# Supabase (same project as the KB — just add auth)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_PRICE_ID=your_stripe_price_id_for_197_monthly

# API keys to proxy (users never see these)
ANTHROPIC_API_KEY=your_anthropic_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key

# Server
PORT=3000
# Google Calendar (independent, read-only; no GHL credentials required)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://scoutsystems.io/calendar/callback
# Base64-encoded 32 random bytes; keep stable to decrypt saved tokens.
GOOGLE_CALENDAR_TOKEN_KEY=
